        <mxCell id="28" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #B91C1C; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Salidas (Productos/Mermas)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Mezcla formulada lista para tolva de extrusión&lt;br&gt;• Mermas de purga y polvo de aditivos&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="680" y="620" width="265" height="110" as="geometry" />
