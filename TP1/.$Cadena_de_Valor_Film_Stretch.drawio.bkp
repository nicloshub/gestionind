        <mxCell id="32" value="&lt;div style='font-size: 24px; text-align: center; line-height: 32px;'&gt;⚙️ 🎞️&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="992" y="232" width="261" height="34" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #1E40AF; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Actores Clave&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Fabricantes / extrusores de film stretch&lt;br&gt;  (Rok Stretch, SonFuertes, Embafor, AMBA)&lt;br&gt;• Operadores técnicos y control de calidad&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="990" y="272" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #0369A1; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Entradas (Insumos/Energía)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Mezcla de PEBDL virgen + PCR + aditivos&lt;br&gt;• Scrap pre-consumo triturado (bucle interno)&lt;br&gt;• Tubos de cartón/plástico (mandriles/cores)&lt;br&gt;• Energía eléctrica y agua de enfriamiento (chiller)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="990" y="373" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="35" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #4338CA; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Procesos Principales&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Extrusión plana multicapa (Cast film 3 a 55 capas)&lt;br&gt;• Salida de labio plano sobre rodillos enfriadores&lt;br&gt;• Enfriamiento rápido (quench roll) para transparencia&lt;br&gt;• Refilado lateral y bobinado automático&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="990" y="489" width="265" height="125" as="geometry" />
        </mxCell>
        <mxCell id="36" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #B91C1C; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Salidas (Productos/Mermas)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Bobinas de film stretch manual (10-15 µm)&lt;br&gt;• Bobinas de film stretch automático (17-30 µm)&lt;br&gt;• Scrap de refilado y despunte (Scrap pre-consumo)&lt;br&gt;• Pérdidas térmicas&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
