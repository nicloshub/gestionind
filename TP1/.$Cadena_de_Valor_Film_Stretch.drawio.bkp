        <mxCell id="9" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #1E40AF; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Actores Clave&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Empresas energéticas y gasíferas (YPF, Pampa Energía, Tecpetrol)&lt;br&gt;• Cuenca Neuquina (Vaca Muerta)&lt;br&gt;• Transporte por gasoducto (TGS)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="272" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="10" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #0369A1; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Entradas (Insumos/Energía)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Yacimientos de gas natural y petróleo crudo&lt;br&gt;• Agua de proceso e insumos químicos&lt;br&gt;• Energía térmica y eléctrica&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="373" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="11" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #4338CA; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Procesos Principales&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Perforación y extracción de gas natural húmedo&lt;br&gt;• Separación primaria y fraccionamiento&lt;br&gt;• Acondicionamiento de etano en Planta Mega&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="489" width="265" height="125" as="geometry" />
        </mxCell>
        <mxCell id="12" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #B91C1C; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Salidas (Productos/Mermas)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Corriente rica en Etano (líquido/gas)&lt;br&gt;• Gas metano a red (CH₄)&lt;br&gt;• Emisiones fugitivas y barros de perforación&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="60" y="620" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 9.5px; font-weight: 700; color: #1E40AF; text-align: center;'&gt;📍 Escala: Nacional / Global&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=none;arcSize=8;align=center;" parent="1" vertex="1">
          <mxGeometry x="62" y="798" width="261" height="22" as="geometry" />
        </mxCell>
        <mxCell id="14" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=4;shadow=0;" parent="1" vertex="1">
          <mxGeometry x="360" y="160" width="285" height="670" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: center;'&gt;&lt;span style='background-color: #0369A1; color: #FFFFFF; font-size: 11px; font-weight: 800; padding: 2px 7px; border-radius: 10px; display: inline-block; margin-bottom: 4px;'&gt;ETAPA 2&lt;/span&gt;&lt;div style='font-size: 12.5px; font-weight: 800; color: #FFFFFF; line-height: 1.2; text-transform: uppercase;'&gt;PETROQUÍMICA BASE&lt;br&gt;(Cracking y Resina)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=none;arcSize=6;align=center;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="366" y="166" width="273" height="60" as="geometry" />
        </mxCell>
        <mxCell id="16" value="&lt;div style='font-size: 24px; text-align: center; line-height: 32px;'&gt;🏭 🔬&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="372" y="232" width="261" height="34" as="geometry" />
        </mxCell>
        <mxCell id="17" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #1E40AF; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Actores Clave&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Dow Argentina (Polo Petroquímico Bahía Blanca)&lt;br&gt;• PBB Polisur&lt;br&gt;• Proveedores de comonómeros y catalizadores&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="370" y="272" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="18" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #0369A1; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Entradas (Insumos/Energía)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Etano por gasoducto dedicado&lt;br&gt;• Catalizadores Ziegler-Natta o metalocenos&lt;br&gt;• Comonómeros (1-buteno, 1-hexeno, 1-octeno)&lt;br&gt;• Energía eléctrica y vapor a alta presión&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="370" y="373" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="19" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #4338CA; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Procesos Principales&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Craqueo térmico de etano (pirólisis a 800°C)&lt;br&gt;• Purificación y fraccionamiento criogénico&lt;br&gt;• Polimerización en fase gaseosa / solución&lt;br&gt;• Granulado en pellets vírgenes de PEBDL (LLDPE)&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="370" y="489" width="265" height="125" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #B91C1C; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Salidas (Productos/Mermas)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Pellets vírgenes de PEBDL (MFI ~1.5 - 3.5 g/10min)&lt;br&gt;• Subproductos: Hidrógeno (H₂), etileno residual&lt;br&gt;• Emisiones de CO₂ y calor residual&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="370" y="620" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="21" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 9.5px; font-weight: 700; color: #0369A1; text-align: center;'&gt;📍 Escala: Nacional / Regional&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=none;arcSize=8;align=center;" parent="1" vertex="1">
          <mxGeometry x="372" y="798" width="261" height="22" as="geometry" />
        </mxCell>
        <mxCell id="22" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=4;shadow=0;" parent="1" vertex="1">
          <mxGeometry x="670" y="160" width="285" height="670" as="geometry" />
        </mxCell>
        <mxCell id="23" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: center;'&gt;&lt;span style='background-color: #0F766E; color: #FFFFFF; font-size: 11px; font-weight: 800; padding: 2px 7px; border-radius: 10px; display: inline-block; margin-bottom: 4px;'&gt;ETAPA 3&lt;/span&gt;&lt;div style='font-size: 12.5px; font-weight: 800; color: #FFFFFF; line-height: 1.2; text-transform: uppercase;'&gt;COMPOUND Y&lt;br&gt;FORMULACIÓN&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=none;arcSize=6;align=center;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="676" y="166" width="273" height="60" as="geometry" />
        </mxCell>
        <mxCell id="24" value="&lt;div style='font-size: 24px; text-align: center; line-height: 32px;'&gt;🧪 📦&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="682" y="232" width="261" height="34" as="geometry" />
        </mxCell>
        <mxCell id="25" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #1E40AF; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Actores Clave&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Formuladores de aditivos (Clariant, Masterbatchers)&lt;br&gt;• Extrusores integrados&lt;br&gt;• Proveedores de resina reciclada PCR&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="680" y="272" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="26" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #0369A1; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Entradas (Insumos/Energía)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Pellets vírgenes de PEBDL / mLLDPE&lt;br&gt;• Aditivos tackificantes (PIB - poliisobutileno para cling)&lt;br&gt;• Resina reciclada postconsumo (R-PEBDL 20-50%)&lt;br&gt;• Deslizantes internos, estabilizantes UV, antioxidantes&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="680" y="373" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #4338CA; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Procesos Principales&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Dosificación gravimétrica de alta precisión&lt;br&gt;• Mezcla seca y extrusión de masterbatch&lt;br&gt;• Calibración de índice de fluidez (MFI) y elasticidad&lt;br&gt;• Ensayos reológicos de compatibilización&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="680" y="489" width="265" height="125" as="geometry" />
