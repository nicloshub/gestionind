        <mxCell id="29" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 9.5px; font-weight: 700; color: #0F766E; text-align: center;'&gt;📍 Escala: Nacional&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CCFBF1;strokeColor=none;arcSize=8;align=center;" parent="1" vertex="1">
