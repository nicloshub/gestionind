          <mxGeometry x="2230" y="272" width="265" height="95" as="geometry" />
        </mxCell>
        <mxCell id="66" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #0369A1; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Entradas (Insumos/Energía)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Film stretch descartado en grandes fardos limpios&lt;br&gt;• Agua de lavado y detergentes industriales&lt;br&gt;• Energía eléctrica en líneas de reciclado mecánico&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9FF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="2230" y="373" width="265" height="110" as="geometry" />
        </mxCell>
        <mxCell id="67" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #4338CA; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Procesos Principales&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Clasificación manual (separación de PVC, etiquetas y flejes)&lt;br&gt;• Lavado intensivo en balsa de flotación (PE flota)&lt;br&gt;• Secado centrífugo y trituración a escamas (flakes)&lt;br&gt;• Extrusión con desgasificado al vacío y re-peletizado&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="2230" y="489" width="265" height="125" as="geometry" />
        </mxCell>
        <mxCell id="68" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10px; text-align: left; line-height: 1.35;'&gt;&lt;div style='font-weight: 800; color: #B91C1C; text-transform: uppercase; font-size: 9.5px; margin-bottom: 2px;'&gt;Salidas (Productos/Mermas)&lt;/div&gt;&lt;div style='color: #1E293B;'&gt;• Pellets de PEBDL reciclado (R-LLDPE / PCR)&lt;br&gt;• Efluentes líquidos (aguas de lavado tratadas)&lt;br&gt;• Rechazos no reciclables a disposición final&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E2E8F0;strokeWidth=1;arcSize=4;align=left;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="2230" y="620" width="265" height="110" as="geometry" />
        </mxCell>
