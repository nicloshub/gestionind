        <mxCell id="77" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: center;'&gt;&lt;span style='background-color: #7C3AED; color: #FFF; font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 8px;'&gt;BUCLE PRE-CONSUMO&lt;/span&gt;&lt;div style='font-size: 11.5px; font-weight: 800; color: #4C1D95; margin-top: 3px;'&gt;SCRAP INDUSTRIAL INTERNO&lt;/div&gt;&lt;div style='font-size: 10px; color: #334155; margin-top: 2px; line-height: 1.25;'&gt;Refilado de bordes, recortes y bobinas falladas se muelen en línea y retornan &lt;b&gt;100% a tolva&lt;/b&gt; sin perder calidad.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#C084FC;strokeWidth=1.5;arcSize=6;align=center;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="980" y="855" width="285" height="75" as="geometry" />
        </mxCell>
        <mxCell id="78" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: center;'&gt;&lt;span style='background-color: #16A34A; color: #FFF; font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 8px;'&gt;BUCLE POST-CONSUMO PRINCIPAL&lt;/span&gt;&lt;div style='font-size: 11.5px; font-weight: 800; color: #14532D; margin-top: 3px;'&gt;RECICLAJE MECÁNICO B2B (R-PEBDL)&lt;/div&gt;&lt;div style='font-size: 10px; color: #334155; margin-top: 2px; line-height: 1.25;'&gt;Acopio limpio en centros logísticos ➔ Lavado y secado ➔ Peletizado de resina reciclada (PCR) de alta pureza.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;strokeWidth=1.5;arcSize=6;align=center;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="1770" y="855" width="425" height="75" as="geometry" />
        </mxCell>
        <mxCell id="79" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: center;'&gt;&lt;span style='background-color: #0284C7; color: #FFF; font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 8px;'&gt;MERCADO DEL MATERIAL RECUPERADO&lt;/span&gt;&lt;div style='font-size: 11.5px; font-weight: 800; color: #0C4A6E; margin-top: 3px;'&gt;APLICACIONES DE PEBDL RECICLADO&lt;/div&gt;&lt;div style='font-size: 10px; color: #334155; margin-top: 2px; line-height: 1.25;'&gt;• &lt;b&gt;Nuevo Film Stretch con PCR (30-50%)&lt;/b&gt; | Bolsas de consorcio e industriales | Madera plástica y tarimas | Caños y tubos.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#7DD3FC;strokeWidth=1.5;arcSize=6;align=center;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="670" y="855" width="305" height="75" as="geometry" />
        </mxCell>
        <mxCell id="80" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: center;'&gt;&lt;span style='background-color: #64748B; color: #FFF; font-size: 9px; font-weight: 800; padding: 2px 6px; border-radius: 8px;'&gt;FIN DE CICLO&lt;/span&gt;&lt;div style='font-size: 11.5px; font-weight: 800; color: #334155; margin-top: 3px;'&gt;DISPOSICIÓN RESIDUAL&lt;/div&gt;&lt;div style='font-size: 10px; color: #475569; margin-top: 2px; line-height: 1.25;'&gt;Relleno sanitario controlado o valorización energética para fracciones altamente contaminadas.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1;arcSize=6;align=center;spacing=6;" parent="1" vertex="1">
          <mxGeometry x="2220" y="855" width="285" height="75" as="geometry" />
        </mxCell>
        <mxCell id="81" value="Retorno de Resina Reciclada (PCR)" style="edgeStyle=curved;html=1;strokeColor=#16A34A;strokeWidth=2.5;strokeFactor=1;dashed=1;dashPattern=6 4;endArrow=block;endFill=1;fontSize=10;fontColor=#15803D;fontStyle=1;align=center;" parent="1" edge="1" source="62" target="30">
          <mxGeometry relative="1" as="geometry">
