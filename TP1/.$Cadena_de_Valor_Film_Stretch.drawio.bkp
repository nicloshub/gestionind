        <mxCell id="8" value="&lt;div style='font-size: 24px; text-align: center; line-height: 32px;'&gt;⛽ 🛢️&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E2E8F0;strokeWidth=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="62" y="232" width="261" height="34" as="geometry" />
