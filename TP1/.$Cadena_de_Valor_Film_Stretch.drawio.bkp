          </mxGeometry>
        </mxCell>
        <mxCell id="82" value="Inclusión en Formulación" style="edgeStyle=curved;html=1;strokeColor=#0D9488;strokeWidth=2;dashed=1;dashPattern=4 4;endArrow=block;endFill=1;fontSize=9;fontColor=#0F766E;align=center;" parent="1" edge="1" source="62" target="22">
          <mxGeometry relative="1" as="geometry">
