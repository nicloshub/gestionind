<mxfile host="app.diagrams.net" version="24.0.0" type="device">
  <diagram id="cadena_valor_film_stretch" name="Cadena de Valor - Film Stretch">
    <mxGraphModel dx="2800" dy="1800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="1850" background="#F8FAFC" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;div style='text-align: left; font-family: Inter, Arial, sans-serif;'&gt;&lt;div style='font-size: 26px; font-weight: 800; color: #0F172A; letter-spacing: -0.5px;'&gt;CADENA DE VALOR DEL FILM STRETCH PARA PALLETS (PEBDL / LLDPE)&lt;/div&gt;&lt;div style='font-size: 15px; font-weight: 600; color: #1E3A8A; margin-top: 4px;'&gt;Desde la extracción de hidrocarburos hasta el postconsumo logístico B2B y su recirculación circular&lt;/div&gt;&lt;div style='font-size: 12px; color: #475569; margin-top: 3px;'&gt;Análisis integral de etapas, actores, entradas, procesos industriales, salidas, pérdidas de valor y estrategias de circularidad 4.0&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=0;strokeColor=none;fillColor=none;" parent="1" vertex="1">
          <mxGeometry x="50" y="25" width="1300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;div style='font-family: Inter, Arial, sans-serif; text-align: left;'&gt;&lt;div style='font-size: 11px; font-weight: 800; color: #1E3A8A; text-transform: uppercase; letter-spacing: 0.5px;'&gt;Producto Representativo&lt;/div&gt;&lt;div style='font-size: 13px; font-weight: 700; color: #0F172A; margin-top: 2px;'&gt;Film Stretch para Pallets (PEBDL / LLDPE)&lt;/div&gt;&lt;div style='font-size: 11px; color: #334155; margin-top: 4px; line-height: 1.3;'&gt;• &lt;b&gt;Aplicación:&lt;/b&gt; Flexible logístico para unitización y contención.&lt;br&gt;• &lt;b&gt;Resina:&lt;/b&gt; Polietileno lineal de baja densidad (Monomaterial).&lt;br&gt;• &lt;b&gt;Vida útil:&lt;/b&gt; Muy corta (Uso único por pallet / Alta rotación B2B).&lt;br&gt;• &lt;b&gt;Normas clave:&lt;/b&gt; ASTM D4649, ASTM D2103, ISO 17855, EUMOS 40509.&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#BFDBFE;strokeWidth=1.5;arcSize=8;align=left;spacing=10;" parent="1" vertex="1">
          <mxGeometry x="1400" y="20" width="520" height="85" as="geometry" />
        </mxCell>
        <mxCell id="4" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 10.5px; text-align: left; line-height: 1.4; color: #1E293B;'&gt;&lt;div style='font-weight: 800; color: #0F172A; margin-bottom: 2px;'&gt;LEYENDA DE FLUJOS Y CIRCULARIDAD&lt;/div&gt;&lt;div&gt;&lt;span style='color:#2563EB; font-weight:bold;'&gt;━━━&lt;/span&gt; Flujo Principal de Material (Lineal / Productivo)&lt;/div&gt;&lt;div&gt;&lt;span style='color:#16A34A; font-weight:bold;'&gt;- - -&lt;/span&gt; Flujo de Reciclaje Mecánico B2B / PCR&lt;/div&gt;&lt;div&gt;&lt;span style='color:#9333EA; font-weight:bold;'&gt;- - -&lt;/span&gt; Bucle Scrap Pre-consumo (Refilado / Planta)&lt;/div&gt;&lt;div&gt;&lt;span style='color:#DC2626; font-weight:bold;'&gt;- - -&lt;/span&gt; Mermas, Emisiones y Descarte Residual&lt;/div&gt;&lt;div style='margin-top:2px;'&gt;&lt;b&gt;Niveles:&lt;/b&gt; &lt;span style='color:#16A34A;'&gt;●&lt;/span&gt; Alto (PCR cerrada) &amp;nbsp; &lt;span style='color:#EAB308;'&gt;●&lt;/span&gt; Medio (Downcycling) &amp;nbsp; &lt;span style='color:#DC2626;'&gt;●&lt;/span&gt; Pérdida&lt;/div&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1;arcSize=8;align=left;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="1940" y="20" width="510" height="85" as="geometry" />
        </mxCell>
        <mxCell id="5" value="&lt;div style='font-family: Inter, Arial, sans-serif; font-size: 12px; font-weight: 700; color: #166534; text-align: center; letter-spacing: 0.5px;'&gt;⟳ BUCLES DE RETORNO Y RECIRCULACIÓN CIRCULAR (RECUPERACIÓN DE RESINAS Y MATERIALES) ⟲&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#86EFAC;strokeWidth=1;arcSize=20;align=center;" parent="1" vertex="1">
          <mxGeometry x="750" y="115" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="6" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=4;shadow=0;" parent="1" vertex="1">
          <mxGeometry x="50" y="160" width="285" height="670" as="geometry" />
