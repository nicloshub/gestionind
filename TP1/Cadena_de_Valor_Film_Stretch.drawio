        <mxCell id="103" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;arcSize=5;align=left;spacing=6;" value="&lt;div style=&#39;font-family: Inter, Arial, sans-serif; text-align: left; line-height: 1.25; padding-left: 4px;&#39;&gt;&lt;div style=&#39;font-size: 11.5px; font-weight: 800; color: #0F172A;&#39;&gt;21. Extrusión y Re-peletizado&lt;/div&gt;&lt;div style=&#39;font-size: 10px; color: #475569; margin-top: 3px;&#39;&gt;Extrusora con desgasificado al vacío y doble filtro.&lt;br&gt;Obtención de pellets reciclados R-PEBDL (PCR)&lt;/div&gt;&lt;/div&gt;" vertex="1">
