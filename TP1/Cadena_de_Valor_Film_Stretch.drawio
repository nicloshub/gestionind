        <mxCell id="102" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;align=center;spacing=2;" value="&lt;div style=&#39;font-family: Inter, Arial, sans-serif; text-align: center; font-size: 8.5px; line-height: 1.25; color: #1E293B;&#39;&gt;&lt;b style=&#39;color: #D97706; font-size: 9.5px;&#39;&gt;ENTRADAS&lt;/b&gt;&lt;br&gt;Film enfardado&lt;br&gt;Agua / Detergentes&lt;br&gt;Energía mecánica&lt;/div&gt;" vertex="1">
